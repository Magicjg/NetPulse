<Application x:Class="NetPulse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NetPulse.App.Converters"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:ProgressWidthConverter x:Key="ProgressWidthConverter"/>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#07111F" po:Freeze="False"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#101B2E" po:Freeze="False"/>
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#18243A" po:Freeze="False"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#24334D" po:Freeze="False"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF" po:Freeze="False"/>
        <SolidColorBrush x:Key="AccentAltBrush" Color="#4F8CFF" po:Freeze="False"/>
        <SolidColorBrush x:Key="AccentPinkBrush" Color="#FB7185" po:Freeze="False"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#123B46" po:Freeze="False"/>
        <SolidColorBrush x:Key="SummaryPanelBrush" Color="#111D31" po:Freeze="False"/>
        <SolidColorBrush x:Key="SourcePanelBrush" Color="#0F1828" po:Freeze="False"/>
        <SolidColorBrush x:Key="ChipNeutralBrush" Color="#27314B" po:Freeze="False"/>
        <SolidColorBrush x:Key="ChipAccentBrush" Color="#193842" po:Freeze="False"/>
        <SolidColorBrush x:Key="ChipAltBrush" Color="#243764" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" po:Freeze="False"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9FB3C8" po:Freeze="False"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" po:Freeze="False"/>

        <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="False">
            <GradientStop Color="#13233D" Offset="0"/>
            <GradientStop Color="#0A1527" Offset="0.55"/>
            <GradientStop Color="#0B2330" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentAltBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
        </Style>

        <Style x:Key="HeroPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="26,14"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinWidth" Value="170"/>
        </Style>

        <Style x:Key="HeroSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="26,14"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <Style x:Key="ThemeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="64"
                                Height="34"
                                Background="{DynamicResource PanelSoftBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17">
                            <Grid>
                                <Border x:Name="Thumb"
                                        Width="26"
                                        Height="26"
                                        Margin="4,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource TextBrush}"
                                        CornerRadius="13"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="AnimatedProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentAltBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="2"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Border CornerRadius="10"
                                        Background="{DynamicResource PanelSoftBrush}"
                                        Opacity="0.95"/>

                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="10"
                                        Background="{TemplateBinding Foreground}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                        </MultiBinding>
                                    </Border.Width>
                                    <Grid ClipToBounds="True">
                                        <Border Opacity="0.35">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#40FFFFFF" Offset="0.45"/>
                                                    <GradientStop Color="#22FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Rectangle x:Name="Shimmer"
                                                   Width="150"
                                                   HorizontalAlignment="Left"
                                                   Opacity="0"
                                                   RadiusX="18"
                                                   RadiusY="18">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#7AFFFFFF" Offset="0.5"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="ShimmerTransform" X="-200"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="10"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Shimmer" Property="Opacity" Value="0.85"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="ProgressShimmerStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="ShimmerTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-220"
                                                             To="1000"
                                                             Duration="0:0:1.7"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="ProgressShimmerStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
